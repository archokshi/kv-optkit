    {"type": "timeseries", "title": "Offload Rate (tokens/s)",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 18},
      "targets": [{"expr": "rate(kvopt_tokens_offloaded_total[1m])"}]
