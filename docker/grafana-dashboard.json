      "options": {"reduceOptions": {"calcs": ["last"], "fields": "", "values": false}}
    },
    {"type": "gauge", "title": "HBM Utilization (%)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "kvopt_hbm_utilization * 100"}],
      "options": {"reduceOptions": {"calcs": ["last"], "fields": "", "values": false},
